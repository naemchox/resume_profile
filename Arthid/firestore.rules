rules_version = '2';

// Security rules for the Arthid Firestore database.
//
// Paste this entire file into the Firebase Console:
//   Build → Firestore Database → Rules tab → replace contents → Publish
//
// Local copy is kept in the repo so the rules version-control alongside
// the schema they protect.

service cloud.firestore {
  match /databases/{database}/documents {

    // ============== USERS ==============
    // Profile docs are readable by any signed-in user so the "Add Friend by
    // primary key" lookup can resolve a peer's uid. Only the owner can
    // create or update their own doc, and nobody can delete (sign-out
    // shouldn't nuke other people's friends list of you).
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;

      // ------ FRIENDS SUBCOLLECTION ------
      // Each friend entry's doc id is the peer's uid. To support bidirectional
      // adds (we write on both sides when you accept), we let any signed-in
      // user create/delete an entry under someone else's /friends as long as
      // the doc id is their own uid. That means "add me as your friend" or
      // "remove me from your list" but never "tamper with someone else's
      // unrelated entries."
      match /friends/{friendUid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, delete: if request.auth != null && (
          request.auth.uid == uid ||
          request.auth.uid == friendUid
        );
        allow update: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ============== CHATS ==============
    // A chat is reachable only by its members. Membership lives in the
    // `members` array on the chat doc. For 1-on-1 chats the chatId is
    // `sortedUidA_sortedUidB`, but the rules don't depend on that format.
    match /chats/{chatId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.members;

      // Creating a new chat: the new doc must list the creator as a member.
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.members;

      // Updating an existing chat (e.g. lastMessage): caller must already be
      // a member, and the members list must still include them after the
      // write — preventing someone from removing themselves and locking the
      // chat for the other side.
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members
                    && request.auth.uid in request.resource.data.members;

      allow delete: if false;

      // ------ MESSAGES SUBCOLLECTION ------
      // Members can read and create. Sender must be the authenticated user;
      // edits and deletes are disabled for now (we'll add edit-history later).
      match /messages/{msgId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if request.auth != null
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow update, delete: if false;
      }

      // ------ TASKS (PLANNER) SUBCOLLECTION ------
      // Any member of the chat can read, create, update, or delete tasks so
      // the shared planner is fully collaborative.
      match /tasks/{taskId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }
    }
  }
}
