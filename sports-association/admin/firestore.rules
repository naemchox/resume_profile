rules_version = '2';

// Sample Sports — สิทธิ์ตาม CONTRACT.md
// อ่าน: ทุกคนอ่าน news/events/albums ที่ published, banners, siteImages ได้
// เขียน: เฉพาะผู้ล็อกอินที่มี doc ใน admins/{uid}
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isPublished() {
      return resource.data.status == 'published';
    }

    function validStatus() {
      return request.resource.data.status in ['published', 'draft'];
    }

    match /news/{id} {
      allow read: if isPublished() || isAdmin();
      allow create, update: if isAdmin() && validStatus()
        && request.resource.data.category in ['announcement', 'press', 'community', 'competition'];
      allow delete: if isAdmin();
    }

    match /events/{id} {
      allow read: if isPublished() || isAdmin();
      allow create, update: if isAdmin() && validStatus()
        && request.resource.data.type in ['major', 'other'];
      allow delete: if isAdmin();
    }

    match /albums/{albumId} {
      allow read: if isPublished() || isAdmin();
      allow create, update: if isAdmin() && validStatus();
      allow delete: if isAdmin();

      match /photos/{photoId} {
        allow read: if isAdmin()
          || get(/databases/$(database)/documents/albums/$(albumId)).data.status == 'published';
        allow write: if isAdmin();
      }
    }

    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteImages/{key} {
      allow read: if true;
      allow write: if isAdmin() && key in [
        'home-about', 'organisation-hero', 'news-hero', 'competition-hero', 'downloads-hero',
        'media-hero', 'about-jumprope-hero', 'contact-hero', 'national-team'
      ];
    }

    // รายชื่อแอดมิน: เพิ่ม/ลบผ่าน Firebase Console เท่านั้น
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
